array = [True, False, True, False, True]
def logical_calc(array, op):
    if op == "AND":
        for i in range(len(array)):
        value = array[i] && array[i+1]
        
    elif op == "OR":
        for i in range(len(array)):
        value = array[i] || array[i+1]
        
    else:
        for i in range(len(array)):
        value = array[i] != array[i+1]
        
    return value